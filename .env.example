# 블로그봇 환경변수 — 이 파일을 복사해 .env 로 저장하고 값을 채우세요.

# ▼ AI 초안 생성 엔진 — 둘 중 하나만 있으면 됩니다. 둘 다 없으면 생성만 비활성
#   (보관함·인사이트·편집·직접 쓰기·프롬프트 복사는 그대로 동작합니다)

# 1) 무료 — 구글 Gemini. 카드 등록 없이 https://aistudio.google.com/apikey 에서 발급.
#    무료 등급은 구글이 입력·출력을 제품 개선에 쓸 수 있으니 민감한 내용은 넣지 마세요.
GEMINI_API_KEY=
# 모델을 바꾸고 싶을 때만 (기본 gemini-2.5-flash)
# GEMINI_MODEL=

# 2) 유료 — Claude. 품질이 가장 좋지만 크레딧 충전이 필요합니다.
#    둘 다 채우면 Claude를 씁니다.
ANTHROPIC_API_KEY=

# ▼ 아래 3개를 모두 채우면 로그인·회원가입·승인·등급이 켜집니다.
#   비워두면 지금처럼 "관리자 단독 로컬 모드"로 동작합니다.
#   Supabase 대시보드 → Project Settings → API 에서 복사.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
