# 블로그봇 환경변수 — 이 파일을 복사해 .env 로 저장하고 값을 채우세요.

# Claude API 키 (AI 초안 생성용). 없으면 생성만 비활성, 보관함·인사이트·편집은 동작.
ANTHROPIC_API_KEY=

# ▼ 아래 3개를 모두 채우면 로그인·회원가입·승인·등급이 켜집니다.
#   비워두면 지금처럼 "관리자 단독 로컬 모드"로 동작합니다.
#   Supabase 대시보드 → Project Settings → API 에서 복사.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
